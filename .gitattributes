# 统一换行：仓库内一律 LF，Windows 检出时也保持 LF，
# 避免 gradlew（shell 脚本）被 CRLF 污染后在 Linux/macOS 上跑不起来。
* text=auto eol=lf

*.kt      text eol=lf
*.kts     text eol=lf
*.java    text eol=lf
*.aidl    text eol=lf
*.xml     text eol=lf
*.md      text eol=lf
*.pro     text eol=lf
*.properties text eol=lf

# gradlew 必须可执行
gradlew   text eol=lf
gradlew.bat text eol=crlf

# 二进制：禁止换行转换与文本 diff
*.jar     binary
*.png     binary
*.jpg     binary
*.webp    binary
*.apk     binary
*.idsig   binary

# 语言统计
*.kt      linguist-language=Kotlin
